{
  "scripts": {
    "front-end": "cd front-end && npm run dev",
    "back-end": "cd back-end && npx ts-node src/index.ts",
    "first-time-back-end": "cd back-end && npm install",
    "first-time-front-end": "cd front-end && npm install",
    "first-time": "concurrently \"npm run first-time-back-end\" \"npm run first-time-front-end\"",
    "dev": "concurrently \"npm run front-end\" \"npm run back-end\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
